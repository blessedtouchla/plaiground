{
  "rewrites": [
    { "source": "/api/auth/:action", "destination": "/api/auth?action=:action" },
    { "source": "/api/me/catalog", "destination": "/api/me?action=catalog" },
    { "source": "/api/me/profile", "destination": "/api/me?action=profile" },
    { "source": "/api/me/artists", "destination": "/api/me?resource=artists" },
    { "source": "/api/admin/signups", "destination": "/api/me?action=admin-signups" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/signups", "destination": "/admin.html" },
    { "source": "/api/signwell/:id", "destination": "/api/signwell?id=:id" },
    { "source": "/api/tonegrid/releases/:id/submit", "destination": "/api/tonegrid?resource=submit&id=:id" },
    { "source": "/api/tonegrid/releases/:id/dsps", "destination": "/api/tonegrid?resource=dsps&id=:id" },
    { "source": "/api/tonegrid/releases/:id/artwork", "destination": "/api/tonegrid?resource=artwork&id=:id" },
    { "source": "/api/tonegrid/releases/:id", "destination": "/api/tonegrid?resource=release&id=:id" },
    { "source": "/api/tonegrid/uploads", "destination": "/api/tonegrid?resource=uploads" },
    { "source": "/api/tonegrid/tracks/:id/audio", "destination": "/api/tonegrid?resource=audio&id=:id" },
    { "source": "/api/tonegrid/tracks/:id", "destination": "/api/tonegrid?resource=track&id=:id" },
    { "source": "/api/tonegrid/webhook", "destination": "/api/tonegrid?resource=webhook" },
    { "source": "/api/tonegrid/:resource", "destination": "/api/tonegrid?resource=:resource" },
    { "source": "/api/stripe/webhook", "destination": "/api/create-checkout-session?action=webhook" }
  ]
}
