{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "wannaplai.com" }],
      "destination": "https://www.wannaplai.com/",
      "permanent": true
    },
    {
      "source": "/:file.html",
      "has": [{ "type": "host", "value": "wannaplai.com" }],
      "destination": "https://www.wannaplai.com/:file.html",
      "permanent": true
    },
    {
      "source": "/admin",
      "has": [{ "type": "host", "value": "wannaplai.com" }],
      "destination": "https://www.wannaplai.com/admin",
      "permanent": true
    },
    {
      "source": "/admin/:path*",
      "has": [{ "type": "host", "value": "wannaplai.com" }],
      "destination": "https://www.wannaplai.com/admin/:path*",
      "permanent": true
    },
    {
      "source": "/pricing.html",
      "destination": "/index.html#pricing",
      "permanent": true
    },
    {
      "source": "/plans.html",
      "destination": "/index.html#pricing",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/index.html#pricing",
      "permanent": true
    },
    {
      "source": "/plans",
      "destination": "/index.html#pricing",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/auth/:action", "destination": "/api/auth?action=:action" },
    { "source": "/api/me/catalog", "destination": "/api/me?action=catalog" },
    { "source": "/api/me/profile", "destination": "/api/me?action=profile" },
    { "source": "/api/me/artists", "destination": "/api/me?resource=artists" },
    { "source": "/api/me/problem", "destination": "/api/me?action=problem" },
    { "source": "/api/admin/signups", "destination": "/api/me?action=admin-signups" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/signups", "destination": "/admin.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/login/", "destination": "/login.html" },
    { "source": "/api/signwell/:id", "destination": "/api/signwell?id=:id" },
    { "source": "/api/tonegrid/releases/:id/submit", "destination": "/api/tonegrid?resource=submit&id=:id" },
    { "source": "/api/tonegrid/releases/:id/dsps", "destination": "/api/tonegrid?resource=dsps&id=:id" },
    { "source": "/api/tonegrid/releases/:id/artwork", "destination": "/api/tonegrid?resource=artwork&id=:id" },
    { "source": "/api/tonegrid/releases/:id", "destination": "/api/tonegrid?resource=release&id=:id" },
    { "source": "/api/tonegrid/uploads", "destination": "/api/tonegrid?resource=uploads" },
    { "source": "/api/tonegrid/tracks/:id/audio", "destination": "/api/tonegrid?resource=audio&id=:id" },
    { "source": "/api/tonegrid/tracks/:id", "destination": "/api/tonegrid?resource=track&id=:id" },
    { "source": "/api/tonegrid/:resource", "destination": "/api/tonegrid?resource=:resource" },
    { "source": "/api/stripe/webhook", "destination": "/api/create-checkout-session?action=webhook" },
    { "source": "/charts", "destination": "/charts.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/blog/welcome", "destination": "/blog-welcome.html" },
    { "source": "/blog/first-release", "destination": "/blog-first-release.html" },
    { "source": "/blog/meet-plai", "destination": "/blog-meet-plai.html" },
    { "source": "/blog/meet-siva", "destination": "/blog-meet-siva.html" },
    { "source": "/blog/what-a-human-did", "destination": "/blog-what-a-human-did.html" },
    { "source": "/blog/split-sheets", "destination": "/blog-split-sheets.html" },
    { "source": "/blog/publishing-is-not-distribution", "destination": "/blog-publishing-is-not-distribution.html" },
    { "source": "/blog/vs-distributors", "destination": "/blog-vs-distributors.html" }
  ],
  "headers": [
    {
      "source": "/review.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/store-client.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ]
}
